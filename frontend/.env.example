# ==============================================================================
# NETRAVAHA Frontend Environment Configuration Template
# Gujarat Police Innovation Challenge 2026
# Placeholders only. NEVER commit real credentials or secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API Connection
# Public HTTPS URL of the deployed NestJS backend (e.g. Render, Railway, Cloud Run)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://netravaha-backend.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 2. Real-Time Alert WebSocket Gateway
# Public WSS URL of the deployed NestJS alert gateway (/ws/alerts)
# If omitted, frontend automatically derives WSS from NEXT_PUBLIC_API_URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=wss://netravaha-backend.onrender.com/ws/alerts

# ------------------------------------------------------------------------------
# 3. MediaMTX Video Gateway / HLS Stream Server
# Public HTTPS base URL where MediaMTX serves HLS .m3u8 live playlists
# Keep unset until production MediaMTX gateway is provisioned; falls back to localhost:8888 for local dev
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HLS_GATEWAY_URL=https://<PROVISIONED_MEDIAMTX_HOST>

# ------------------------------------------------------------------------------
# 4. Map & Visualization Settings (Optional)
# Custom Mapbox / MapLibre style JSON or tile endpoint (defaults to embedded tactical dark vector style)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE=

# ------------------------------------------------------------------------------
# 5. Governance & Demonstration Disclosures
# Controls the visibility of the "SIMULATED LIVE CCTV" header badge
# Set to 'false' in production police deployments; leave 'true' or unset for hackathon evaluation
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SIMULATED_DATA_BADGE=true

# ------------------------------------------------------------------------------
# 6. Next.js Same-Origin Reverse Proxy (Server-to-Server)
# Base backend URL used by Next.js /api/v1/:path* rewrites to avoid browser CORS/Mixed Content
# ------------------------------------------------------------------------------
BACKEND_INTERNAL_URL=https://netravaha-backend.onrender.com
