# ==============================================================================
# NETRAVAHA Frontend Environment Configuration Template
# Gujarat Police Innovation Challenge 2026
# Placeholders only. NEVER commit real credentials or secrets to source control.
# ==============================================================================

# Next.js Server Port (default: 3000)
PORT=3000

# Backend REST API base URL (exposed to browser client)
NEXT_PUBLIC_API_URL=<BACKEND_API_PUBLIC_URL>

# Backend WebSocket URL (for real-time alert dispatch)
NEXT_PUBLIC_WS_URL=<BACKEND_WS_PUBLIC_URL>

# MediaMTX HLS Gateway URL (for browser HLS live streams)
NEXT_PUBLIC_HLS_GATEWAY_URL=<HLS_GATEWAY_PUBLIC_URL>

# Internal backend URL used by Next.js API rewrites (server-to-server)
BACKEND_INTERNAL_URL=<BACKEND_INTERNAL_SERVICE_URL>
