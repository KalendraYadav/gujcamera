# ==============================================================================
# Unified CCTV Intelligence Platform — Environment Configuration Template
# Gujarat Police Innovation Challenge 2026
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (never commit '.env' to version control):
#    cp .env.example .env
# 2. Update default passwords and secrets before running in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
# POSTGRES_USER: Database superuser username
POSTGRES_USER=gujcamera_admin

# POSTGRES_PASSWORD: Database password for local development
POSTGRES_PASSWORD=gujcamera_dev_secret

# POSTGRES_DB: Primary database name
POSTGRES_DB=gujcamera_db

# POSTGRES_PORT: Host port mapped to PostgreSQL in Docker (default: 5432)
POSTGRES_PORT=5432

# POSTGRES_HOST: Host address for database connections from backend
POSTGRES_HOST=localhost

# DATABASE_URL: Standard PostgreSQL connection string used by ORM (Prisma/TypeORM)
DATABASE_URL=postgresql://gujcamera_admin:gujcamera_dev_secret@localhost:5432/gujcamera_db?schema=public

# ------------------------------------------------------------------------------
# 2. IN-MEMORY CACHE & EVENT STREAM (Redis 7)
# ------------------------------------------------------------------------------
# REDIS_HOST: Host address for Redis
REDIS_HOST=localhost

# REDIS_PORT: Host port mapped to Redis in Docker (default: 6379)
REDIS_PORT=6379

# REDIS_PASSWORD: Optional password for Redis (empty for local development)
REDIS_PASSWORD=

# REDIS_URL: Full connection URI for Redis clients and message queues
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. EVIDENCE OBJECT STORAGE (MinIO S3-Compatible)
# ------------------------------------------------------------------------------
# MINIO_ROOT_USER: Root admin access key for MinIO
MINIO_ROOT_USER=minio_admin

# MINIO_ROOT_PASSWORD: Root admin secret key (min 8 characters)
MINIO_ROOT_PASSWORD=minio_dev_secret_2026

# MINIO_PORT: S3 API port (default: 9000)
MINIO_PORT=9000

# MINIO_CONSOLE_PORT: MinIO Web Management Console port (default: 9001)
MINIO_CONSOLE_PORT=9001

# MINIO_BUCKET_NAME: S3 bucket where snapshot evidence and frames are stored
MINIO_BUCKET_NAME=police-evidence-vault

# MINIO_ENDPOINT: Host endpoint for MinIO S3 client
MINIO_ENDPOINT=http://localhost:9000

# ------------------------------------------------------------------------------
# 4. BACKEND API SERVICE (NestJS Modular Monolith)
# ------------------------------------------------------------------------------
# NODE_ENV: Application runtime environment ('development', 'test', 'production')
NODE_ENV=development

# BACKEND_PORT: HTTP listening port for backend API (per Master Architecture v1.1)
BACKEND_PORT=4000

# API_PREFIX: Global routing prefix for all REST endpoints
API_PREFIX=/api/v1

# CORS_ORIGINS: Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. SECURITY & AUTHENTICATION (JWT & RBAC)
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign short-lived access tokens
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# JWT_EXPIRES_IN: Lifespan of access token (15 minutes per architecture)
JWT_EXPIRES_IN=15m

# JWT_REFRESH_SECRET: Secret key used to sign refresh tokens
JWT_REFRESH_SECRET=change_this_to_another_secure_random_string

# JWT_REFRESH_EXPIRES_IN: Lifespan of refresh token (7 days)
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 6. FRONTEND APPLICATION (Next.js Command Center UI)
# ------------------------------------------------------------------------------
# PORT: Local web server port for frontend
FRONTEND_PORT=3000

# NEXT_PUBLIC_API_URL: Public URL of the backend REST API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# NEXT_PUBLIC_WS_URL: Public URL of the WebSocket gateway for real-time alerts
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# NEXT_PUBLIC_SIMULATED_DATA_BADGE: Forces visual 'SIMULATED DATA' badge (true/false)
NEXT_PUBLIC_SIMULATED_DATA_BADGE=true

# ------------------------------------------------------------------------------
# 7. VIDEO INGESTION & AI ANALYTICS PIPELINE
# ------------------------------------------------------------------------------
# RTSP_SIMULATOR_PORT: Port for local synthetic camera feed streaming
RTSP_SIMULATOR_PORT=8554

# AI_FRAME_SAMPLING_RATE: Frames per second extracted for detection (default: 3 fps)
AI_FRAME_SAMPLING_RATE=3

# AI_DETECTION_CONFIDENCE: Minimum confidence threshold for vehicle bounding boxes
AI_DETECTION_CONFIDENCE=0.50

# AI_CONSENSUS_FRAME_COUNT: Number of consecutive frames needed for majority vote
AI_CONSENSUS_FRAME_COUNT=5

# ALERT_COOLDOWN_SECONDS: Deduplication window to suppress duplicate alerts (seconds)
ALERT_COOLDOWN_SECONDS=300
