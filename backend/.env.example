# ==============================================================================
# NETRAVAHA Backend Environment Configuration Template
# Gujarat Police Innovation Challenge 2026
# Placeholders only. NEVER commit real credentials or secrets to source control.
# ==============================================================================

# Database Connectivity (Supabase / PostgreSQL)
# Application runtime uses the connection pooler URL (e.g., Supabase Session/Transaction pooler)
DATABASE_URL=<SUPABASE_POOLER_CONNECTION_STRING>
# Direct connection URL used by Prisma CLI for migrations / schema management
DIRECT_URL=<SUPABASE_DIRECT_CONNECTION_STRING>

# Local PostgreSQL Fallbacks (if running local development database)
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=<DB_NAME>
POSTGRES_PORT=5432

# Redis Stream Bus & State Cache (Upstash / Managed Redis / Local Docker)
REDIS_HOST=<REDIS_HOST>
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_TLS=false
REDIS_URL=<REDIS_CONNECTION_URL>

# S3 / MinIO Evidence Vault
MINIO_ENDPOINT=<STORAGE_ENDPOINT_URL>
MINIO_ROOT_USER=<STORAGE_ACCESS_KEY>
MINIO_ROOT_PASSWORD=<STORAGE_SECRET_KEY>

# JWT Authentication
JWT_SECRET=<GENERATED_SECRET>
JWT_REFRESH_SECRET=<GENERATED_SECRET>

# Server Port & CORS
PORT=4000
CORS_ORIGINS=<ALLOWED_ORIGINS_COMMA_SEPARATED>

# Media Gateway / MediaMTX Integration
MEDIAMTX_API_URL=<MEDIAMTX_API_URL>
MEDIAMTX_INTERNAL_RTSP_BASE_URL=<MEDIAMTX_RTSP_BASE_URL>
MEDIAMTX_API_USER=<MEDIAMTX_API_USER>
MEDIAMTX_API_PASSWORD=<MEDIAMTX_API_PASSWORD>

# Master Encryption Key for Camera Credential Vault (32-byte Base64 secret)
CAMERA_CREDENTIAL_ENCRYPTION_KEY=<32_BYTE_BASE64_SECRET>
