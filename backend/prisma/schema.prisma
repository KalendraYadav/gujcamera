generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model Department {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  parentDepartmentId String?      @map("parent_department_id") @db.Uuid
  retentionPolicyId  String?      @map("retention_policy_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  cameras            Camera[]
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[] @relation("DepartmentHierarchy")
  users              User[]
  watchlists         Watchlist[]

  @@map("departments")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  permissions Permission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  resource  String
  action    String
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("permissions")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String     @map("password_hash")
  roleId             String     @map("role_id") @db.Uuid
  departmentId       String     @map("department_id") @db.Uuid
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  isActive           Boolean    @default(true) @map("is_active")
  lastLogin          DateTime?  @map("last_login")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  alertsAcknowledged Alert[]    @relation("AlertAcknowledgedBy")
  alertsResolved     Alert[]    @relation("AlertResolvedBy")
  auditLogs          AuditLog[]
  incidents          Incident[]
  department         Department @relation(fields: [departmentId], references: [id])
  role               Role       @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}

model Connector {
  id          String   @id @default(uuid()) @db.Uuid
  adapterType String   @map("adapter_type")
  configRef   String   @map("config_ref")
  createdAt   DateTime @default(now()) @map("created_at")
  cameras     Camera[]

  @@map("connectors")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Camera {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  departmentId      String            @map("department_id") @db.Uuid
  lat               Decimal           @db.Decimal(10, 7)
  long              Decimal           @db.Decimal(10, 7)
  protocol          CameraProtocol    @default(RTSP)
  connectorTypeId   String            @map("connector_type_id") @db.Uuid
  operationalStatus OperationalStatus @default(OFFLINE) @map("operational_status")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  credential        CameraCredential?
  health            CameraHealth?
  streams           CameraStream[]
  connector         Connector         @relation(fields: [connectorTypeId], references: [id])
  department        Department        @relation(fields: [departmentId], references: [id])
  detections        Detection[]
  location          Location?
  sightings         VehicleSighting[]

  @@index([departmentId, operationalStatus])
  @@map("cameras")
}

model CameraCredential {
  id             String         @id @default(uuid()) @db.Uuid
  cameraId       String         @unique @map("camera_id") @db.Uuid
  credentialType CredentialType @default(BASIC_AUTH) @map("credential_type")
  encryptedData  String         @map("encrypted_data")
  iv             String         @map("iv")
  authTag        String         @map("auth_tag")
  keyVersion     String         @default("v1") @map("key_version")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  camera         Camera         @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@map("camera_credentials")
}

model Location {
  cameraId  String   @id @map("camera_id") @db.Uuid
  address   String
  zone      String
  district  String
  createdAt DateTime @default(now()) @map("created_at")
  camera    Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@map("locations")
}

model CameraStream {
  id          String   @id @default(uuid()) @db.Uuid
  cameraId    String   @map("camera_id") @db.Uuid
  codec       String   @default("h264")
  resolution  String   @default("1920x1080")
  fps         Int      @default(15)
  urlOrHandle String   @map("url_or_handle")
  createdAt   DateTime @default(now()) @map("created_at")
  camera      Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId])
  @@map("camera_streams")
}

model CameraHealth {
  cameraId      String            @id @map("camera_id") @db.Uuid
  lastHeartbeat DateTime          @default(now()) @map("last_heartbeat")
  fpsActual     Decimal?          @map("fps_actual") @db.Decimal(5, 2)
  packetLoss    Decimal?          @map("packet_loss") @db.Decimal(5, 2)
  status        OperationalStatus @default(ONLINE)
  updatedAt     DateTime          @updatedAt @map("updated_at")
  camera        Camera            @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@map("camera_health")
}

model Detection {
  id              String           @id @default(uuid()) @db.Uuid
  cameraId        String           @map("camera_id") @db.Uuid
  ts              DateTime
  type            DetectionType    @default(VEHICLE)
  bbox            Json
  confidence      Decimal          @db.Decimal(5, 4)
  createdAt       DateTime         @default(now()) @map("created_at")
  camera          Camera           @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  plateDetections PlateDetection[]

  @@index([cameraId, ts])
  @@map("detections")
}

model PlateDetection {
  id          String    @id @default(uuid()) @db.Uuid
  detectionId String    @map("detection_id") @db.Uuid
  rawText     String    @map("raw_text")
  confidence  Decimal   @db.Decimal(5, 4)
  frameRef    String    @map("frame_ref")
  createdAt   DateTime  @default(now()) @map("created_at")
  detection   Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([detectionId])
  @@map("plate_detections")
}

model Vehicle {
  plateNormalized String            @id @map("plate_normalized")
  firstSeen       DateTime          @default(now()) @map("first_seen")
  lastSeen        DateTime          @default(now()) @map("last_seen")
  attributes      Json?
  sightings       VehicleSighting[]

  @@index([lastSeen])
  @@map("vehicles")
}

model VehicleSighting {
  id              String    @id @default(uuid()) @db.Uuid
  plateNormalized String    @map("plate_normalized")
  cameraId        String    @map("camera_id") @db.Uuid
  ts              DateTime
  confidence      Decimal   @db.Decimal(5, 4)
  consensusOf     Int       @default(1) @map("consensus_of")
  frameRef        String    @map("frame_ref")
  createdAt       DateTime  @default(now()) @map("created_at")
  vehicleClass    String?   @map("vehicle_class")
  alerts          Alert[]
  evidence        Evidence?
  camera          Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  vehicle         Vehicle   @relation(fields: [plateNormalized], references: [plateNormalized], onDelete: Cascade)

  @@index([plateNormalized, ts])
  @@index([cameraId, ts])
  @@map("vehicle_sightings")
}

model Watchlist {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  departmentId String           @map("department_id") @db.Uuid
  owner        String
  createdAt    DateTime         @default(now()) @map("created_at")
  entries      WatchlistEntry[]
  department   Department       @relation(fields: [departmentId], references: [id])

  @@map("watchlists")
}

model WatchlistEntry {
  id              String        @id @default(uuid()) @db.Uuid
  watchlistId     String        @map("watchlist_id") @db.Uuid
  plateNormalized String        @map("plate_normalized")
  category        String
  reason          String
  priority        AlertSeverity @default(HIGH)
  addedBy         String        @map("added_by")
  expiresAt       DateTime?     @map("expires_at")
  incidentStart   DateTime?     @map("incident_start") @db.Timestamptz(3)
  incidentEnd     DateTime?     @map("incident_end")   @db.Timestamptz(3)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  alerts          Alert[]
  watchlist       Watchlist     @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@index([plateNormalized, active])
  @@map("watchlist_entries")
}

model Alert {
  id               String          @id @default(uuid()) @db.Uuid
  sourceSightingId String          @map("source_sighting_id") @db.Uuid
  watchlistEntryId String          @map("watchlist_entry_id") @db.Uuid
  severity         AlertSeverity
  status           AlertStatus     @default(NEW)
  ts               DateTime        @default(now())
  acknowledgedById String?         @map("acknowledged_by_id") @db.Uuid
  resolvedById     String?         @map("resolved_by_id") @db.Uuid
  dismissalReason  String?         @map("dismissal_reason")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  acknowledgedBy   User?           @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  resolvedBy       User?           @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  sighting         VehicleSighting @relation(fields: [sourceSightingId], references: [id], onDelete: Cascade)
  watchlistEntry   WatchlistEntry  @relation(fields: [watchlistEntryId], references: [id], onDelete: Cascade)

  @@index([status, ts])
  @@map("alerts")
}

model Incident {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  openedById      String         @map("opened_by_id") @db.Uuid
  status          IncidentStatus @default(OPEN)
  relatedAlertIds String[]       @default([]) @map("related_alert_ids")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  openedBy        User           @relation(fields: [openedById], references: [id])

  @@map("incidents")
}

model Evidence {
  id         String             @id @default(uuid()) @db.Uuid
  sourceType EvidenceSourceType @map("source_type")
  sourceId   String             @unique @map("source_id") @db.Uuid
  storageRef String             @map("storage_ref")
  hash       String
  capturedAt DateTime           @default(now()) @map("captured_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  sighting   VehicleSighting    @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@map("evidence")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  resource      String
  before        Json?
  after         Json?
  ts            DateTime @default(now())
  correlationId String?  @map("correlation_id") @db.Uuid
  actor         User?    @relation(fields: [actorId], references: [id])

  @@index([resource, ts])
  @@map("audit_logs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum OperationalStatus {
  ONLINE
  CONNECTING
  DEGRADED
  OFFLINE
  ERROR
}

enum CameraProtocol {
  RTSP
  ONVIF
  MOCK_VENDOR
  VENDOR_API
}

enum CredentialType {
  BASIC_AUTH
  ONVIF_TOKEN
  BEARER_TOKEN
  CUSTOM
}

enum DetectionType {
  VEHICLE
  PERSON
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CLOSED
}

enum EvidenceSourceType {
  SIGHTING
  ALERT
}
